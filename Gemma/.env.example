# Copie para .env e ajuste conforme o ambiente.
# Node 20.6+ le automaticamente com: node --env-file=.env server.js
# Em versoes mais antigas, exporte essas variaveis via systemd/pm2/shell.

PORT=8787

# Ollama rodando na mesma maquina/rede da GPU
OLLAMA_URL=http://localhost:11434
GEMMA_MODEL=gemma4:12b-it-q4_K_M

# Troque pelo dominio real onde o index.html do Spelling Bee fica hospedado.
# Nao deixe '*' em producao.
ALLOWED_ORIGIN=https://seu-dominio-do-spelling-bee.com

OLLAMA_TIMEOUT_MS=4000
MAX_CONCURRENT_REQUESTS=4
